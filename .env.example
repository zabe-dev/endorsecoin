# Authentication and email.
# BETTER_AUTH_SECRET: long random signing key; required in production.
# BETTER_AUTH_URL: canonical public app URL; example https://endorsecoin.com.
# GOOGLE_CLIENT_ID/SECRET: optional Google OAuth credentials; leave both blank to disable Google login.
# RESEND_API_KEY: Resend key for verification and password-reset emails; example re_....
# AUTH_EMAIL_FROM: sender identity; example EndorseCoin <no-reply@endorsecoin.com>.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Database and local development.
# DATABASE_URL: PostgreSQL connection string; example postgresql://user:password@host:5432/db.
# DEV_RESET_KEEP_USER_EMAIL: local reset helper preserves this user; leave blank to preserve no user.
DATABASE_URL=
DEV_RESET_KEEP_USER_EMAIL=jaybeza@outlook.ph

# Redis and rate limiting.
# REDIS_URL: Redis connection string for shared cache and locks; example redis://user:password@host:6379.
# RATE_LIMIT_FALLBACK_MAX_SUBJECTS: in-memory rate-limit subject cap during database/Redis failure; default 5000.
REDIS_URL=
RATE_LIMIT_FALLBACK_MAX_SUBJECTS=5000

# Protected endpoints and metrics.
# Use long random bearer tokens for secret values. DIAGNOSTICS_TOKEN is shared fallback for metrics/readiness.
# MAINTENANCE_SECRET: /api/maintenance/run. METRICS_TOKEN: optional /api/metrics override.
# HEALTH_READINESS_TOKEN: optional /api/health/readiness override.
# METRICS_LOGS: set true to write metric logs; default false.
# METRICS_MAX_SERIES: in-memory metric-series limit; default 250.
DIAGNOSTICS_TOKEN=
MAINTENANCE_SECRET=
METRICS_TOKEN=
METRICS_LOGS=false
METRICS_MAX_SERIES=250
HEALTH_READINESS_TOKEN=

# Cloudflare Turnstile.
# CLOUDFLARE_TURNSTILE_SECRET_KEY: server verification key; keep secret.
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY: browser-visible public site key.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Cloudflare R2 and social image.
# R2_ACCOUNT_ID or R2_ENDPOINT: configure the R2 S3-compatible endpoint; use one.
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY: bucket credentials; keep secret.
# R2_BUCKET_NAME: bucket for uploaded project logos.
# R2_PUBLIC_URL: public bucket/custom-domain URL; example https://assets.endorsecoin.com.
# NEXT_PUBLIC_SOCIAL_IMAGE_URL: public URL for the default social preview image.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
NEXT_PUBLIC_SOCIAL_IMAGE_URL=https://assets.endorsecoin.com/site/image-1200x628.png

# Topbar prices and display settings.
# TOPBAR_PRICE_REFRESH_SECRET: bearer token for /api/topbar/prices/refresh; use a long random string.
# TOPBAR_PRICE_DAILY_LIMIT: maximum provider requests per day; default 480.
# TOPBAR_USERS_DISPLAY_OFFSET/TOTAL_VOTES_DISPLAY_OFFSET: non-negative display offsets; defaults 300/5000.
# TOPBAR_BINANCE_FALLBACK_BASE_URLS: comma-separated public HTTPS Binance endpoints.
TOPBAR_PRICE_REFRESH_SECRET=
TOPBAR_PRICE_DAILY_LIMIT=480
TOPBAR_USERS_DISPLAY_OFFSET=300
TOPBAR_TOTAL_VOTES_DISPLAY_OFFSET=5000
TOPBAR_BINANCE_FALLBACK_BASE_URLS=https://api.binance.com,https://data-api.binance.vision

# Market data providers.
# MOBULA_API_KEYS: one or more comma-separated secret keys; the app rotates between them.
# *_API_BASE_URL: provider endpoint; defaults are shown below.
# *_REQUEST_TIMEOUT_MS: request timeout. *_REQUEST_SPACING_MS: minimum delay between requests.
# DEXPAPRIKA_API_KEY is optional; leave blank when public access is enough.
MOBULA_API_KEYS=
MOBULA_API_BASE_URL=https://api.mobula.io
MOBULA_REQUEST_TIMEOUT_MS=8000
MOBULA_REQUEST_SPACING_MS=1050
GECKOTERMINAL_API_BASE_URL=https://api.geckoterminal.com
GECKOTERMINAL_REQUEST_SPACING_MS=6100
DEXPAPRIKA_API_KEY=
DEXPAPRIKA_API_BASE_URL=https://api.dexpaprika.com
DEXPAPRIKA_REQUEST_SPACING_MS=2100

# Market sync worker.
# MARKET_SYNC_SECRET: bearer token for /api/market/sync; use a long random string.
# MARKET_SYNC_LIMIT/MAX_LIMIT: default and hard maximum coins per run; defaults 7/120.
# MARKET_SYNC_ON_PAGE: set true to refresh during page reads; keep false in production.
# MARKET_SYNC_LOCK_TTL_MS: Redis lock lifetime; default 120000 ms.
# MARKET_SYNC_ERROR_BACKOFF_MS/MAX_ERROR_BACKOFF_MS: retry delays; defaults 900000/43200000 ms.
MARKET_SYNC_SECRET=
MARKET_SYNC_LIMIT=7
MARKET_SYNC_MAX_LIMIT=120
MARKET_SYNC_ON_PAGE=false
MARKET_SYNC_LOCK_TTL_MS=120000
MARKET_SYNC_ERROR_BACKOFF_MS=900000
MARKET_SYNC_MAX_ERROR_BACKOFF_MS=43200000

# Optional cache tuning. Leave this entire block unchanged unless cache behavior needs adjustment.
# Defaults are production-safe. All durations use seconds unless the variable name ends in `_MS`.
# REDIS_RETRY_PAUSE_MS: pause after Redis failure; default 30000 ms.
# *_CACHE_SECONDS: cache lifetime for the named feature; use a positive integer.
# TOPBAR_PRICE_FETCH_ON_MISS: set false to stop visitor requests from fetching uncached prices; default true.
# TOPBAR_PRICE_LAST_GOOD_SECONDS: retention for last-known-good topbar prices; default 86400.
# MARKET_SYNC_CACHE_SECONDS: market snapshot freshness window; default 900.
REDIS_RETRY_PAUSE_MS=30000
COIN_INTERACTION_CACHE_SECONDS=30
DISCOVERY_CACHE_SECONDS=30
LEADERBOARD_CACHE_SECONDS=30
PROMOTED_COINS_CACHE_SECONDS=60
PUBLIC_COIN_LIST_CACHE_SECONDS=60
PUBLIC_COIN_DETAIL_CACHE_SECONDS=60
PUBLIC_WATCHLIST_CACHE_SECONDS=60
PUBLIC_AIRDROP_LIST_CACHE_SECONDS=60
APPROVED_PROJECT_OPTIONS_CACHE_SECONDS=60
DIGEST_CACHE_SECONDS=60
TOPBAR_SUMMARY_CACHE_SECONDS=60
BANNER_AD_CACHE_SECONDS=60
TOPBAR_PRICE_CACHE_SECONDS=120
TOPBAR_PRICE_LAST_GOOD_SECONDS=86400
TOPBAR_PRICE_FETCH_ON_MISS=true
MARKET_SYNC_CACHE_SECONDS=900

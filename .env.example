# Required once Better Auth is enabled.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google login when configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production for signup verification and password reset codes.
# The default Resend sandbox sender only works for verified recipient testing.
RESEND_API_KEY=
AUTH_EMAIL_FROM="EndorseCoin <no-reply@endorsecoin.com>"

# Required once persistent application data is enabled.
DATABASE_URL=
DEV_RESET_KEEP_USER_EMAIL=jaybeza@outlook.ph

# Optional: shared Redis cache for faster repeated public reads.
REDIS_URL=
REDIS_RETRY_PAUSE_MS=30000
COIN_INTERACTION_CACHE_SECONDS=30
DISCOVERY_CACHE_SECONDS=30
LEADERBOARD_CACHE_SECONDS=30
PROMOTED_COINS_CACHE_SECONDS=60
PUBLIC_COIN_LIST_CACHE_SECONDS=60
PUBLIC_COIN_DETAIL_CACHE_SECONDS=60
PUBLIC_WATCHLIST_CACHE_SECONDS=60
PUBLIC_AIRDROP_LIST_CACHE_SECONDS=60
RATE_LIMIT_FALLBACK_MAX_SUBJECTS=5000

# Optional: protected diagnostics, metrics, and scheduled maintenance endpoints.
DIAGNOSTICS_TOKEN=
MAINTENANCE_SECRET=
METRICS_TOKEN=
METRICS_LOGS=false
METRICS_MAX_SERIES=250
HEALTH_READINESS_TOKEN=

# Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Required for submitted project logos and future static project assets.
# Use R2_ACCOUNT_ID or R2_ENDPOINT. R2_PUBLIC_URL should be a public bucket/custom domain.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional: topbar market/platform data refresh and API safety limits.
TOPBAR_SUMMARY_CACHE_SECONDS=60
BANNER_AD_CACHE_SECONDS=60
TOPBAR_PRICE_CACHE_SECONDS=120
TOPBAR_PRICE_LAST_GOOD_SECONDS=86400
TOPBAR_PRICE_FETCH_ON_MISS=true
TOPBAR_PRICE_REFRESH_SECRET=
TOPBAR_PRICE_DAILY_LIMIT=480
TOPBAR_BINANCE_API_BASE_URL=
TOPBAR_BINANCE_FALLBACK_BASE_URLS=https://api.binance.com,https://data-api.binance.vision

# Optional: Mobula token market data sync. Free tier is 1 request/sec.
MOBULA_API_KEY=
MOBULA_API_KEYS=
MOBULA_API_BASE_URL=https://api.mobula.io
MOBULA_REQUEST_TIMEOUT_MS=8000
MOBULA_REQUEST_SPACING_MS=1050

# Optional: market sync controls.
MARKET_SYNC_SECRET=
MARKET_SYNC_CACHE_SECONDS=900
MARKET_SYNC_LIMIT=7
MARKET_SYNC_MAX_LIMIT=120
MARKET_SYNC_ON_PAGE=false
MARKET_SYNC_LOCK_TTL_MS=120000
MARKET_SYNC_ERROR_BACKOFF_MS=900000
MARKET_SYNC_MAX_ERROR_BACKOFF_MS=43200000
